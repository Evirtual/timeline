{
  "name": "timeline",
  "version": "1.0.0",
  "private": true,
  "description": "A comparative timeline of AI companies — who shipped what, and when.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
